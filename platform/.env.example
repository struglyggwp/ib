DJANGO_SECRET_KEY=replace-with-a-long-random-secret-at-least-50-characters
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@training.test
DJANGO_SUPERUSER_PASSWORD=ChangeThis-Immediately-2026!

POSTGRES_DB=awareness
POSTGRES_USER=awareness
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
TIME_ZONE=Europe/Moscow

# Тестовая почта: Mailpit (Docker profile mailtest). Для Zimbra заменить host/port/TLS/учётные данные.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USE_STARTTLS=0
SMTP_USE_SSL=0
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=training@training.test
SMTP_TEST_RECIPIENTS=tester@training.test

# v0.15: строго ограниченная отправка учебных кампаний. По умолчанию ВЫКЛЮЧЕНА.
SMTP_CAMPAIGN_ENABLED=0
# v0.18: сигнал загрузки изображения (не гарантирует, что письмо прочитал человек).
# Установите 0, если в организации не разрешён такой учёт.
SMTP_OPEN_TRACKING_ENABLED=1
# Явно перечислите только корпоративные домены получателей; никаких '*'
SMTP_ALLOWED_RECIPIENT_DOMAINS=
SMTP_MAX_PER_CAMPAIGN=100
SMTP_MAX_PER_MINUTE=10
# Для реальной Zimbra: https://training.company.example, hostname должен совпадать с подтверждённым доменом
SIMULATION_PUBLIC_BASE_URL=

# v0.17: одна кнопка на карточке кампании. Для Zimbra SMTP_USERNAME=SMTP_FROM_EMAIL.
# Публичный DNS TXT для отправителя не требуется.
# Домен учебных ссылок, разрешённый явно; внутри сети должен работать HTTPS.
SIMULATION_ALLOWED_LINK_HOSTS=
# Mailpit: адрес страницы открывается на том же ПК:
SIMULATION_LOCAL_BASE_URL=http://127.0.0.1:8080

# Точные корпоративные псевдонимы, делегированные SMTP_USERNAME в Zimbra
SMTP_APPROVED_ALIASES=
# IP внутренней Zimbra для профиля zimbra, пример 10.10.10.25
ZIMBRA_LAN_IP=
# Внутреннее имя из сертификата Zimbra
ZIMBRA_TLS_NAME=mail.corp.test
